{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bat84code.local/schemas/findings-v1.schema.json",
  "title": "BAT84CODE normalized finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_id", "severity", "confidence", "status", "location", "message", "evidence", "tool", "remediation"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "rule_id": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["critical", "high", "medium", "low", "info", "unknown"] },
    "confidence": { "enum": ["high", "medium", "low", "unknown"] },
    "status": { "enum": ["detected", "confirmed", "dismissed", "fixed", "not_verified"] },
    "location": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 } } },
    "message": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "digest"], "properties": { "kind": { "enum": ["tool_output", "source_span", "test"] }, "digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" } } } },
    "tool": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" } } },
    "remediation": { "type": "object", "additionalProperties": false, "required": ["available", "patch_digest"], "properties": { "available": { "type": "boolean" }, "patch_digest": { "type": ["string", "null"] } } }
  }
}

